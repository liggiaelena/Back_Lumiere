# Used only for standalone (non-Docker) local runs, e.g. against a cloud DB.
# Leave unset when running via docker-compose.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-luna
OPENAI_REGION_MODEL=gpt-5.6-luna
MAX_UNFINISHED_ANALYSES=10
ANALYSIS_WORKER_CONCURRENCY=2
OPENAI_REGION_CONCURRENCY=3
RECOMMENDATION_WORKER_CONCURRENCY=1
JOB_POLL_INTERVAL_SECONDS=0.75
JOB_STALE_AFTER_SECONDS=600
UPLOAD_STORAGE_DIR=.runtime/uploads
SAVE_SEGFORMER_DEBUG_OUTPUTS=false
