# ANTHROPIC_API_KEY and the DB password are no longer read from this file.
# They are provided as Docker secrets instead — see /secrets/*.txt.example
# at the project root and the `secrets:` block in docker-compose.yml.

# Used only for standalone (non-Docker) local runs, e.g. against a cloud DB.
# Leave unset when running via docker-compose.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-terra
